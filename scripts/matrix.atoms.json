{
  "1 \u00b7 Button": {
    "cssPath": "src/renderer/src/atoms/Button/Button.module.css",
    "base": "button",
    "variants": [
      "primary",
      "secondary",
      "ghost",
      "danger"
    ],
    "states": [
      null,
      "hover",
      "active",
      "disabled"
    ],
    "chip": {
      "label": "Add colour",
      "height": "var(--control-height-lg)",
      "padding": "0 var(--space-5)",
      "fontSize": "var(--text-14)",
      "fontWeight": "var(--weight-bold)",
      "radius": "var(--radius-full)"
    }
  },
  "5 \u00b7 Badge": {
    "cssPath": "src/renderer/src/atoms/Badge/Badge.module.css",
    "base": "badge",
    "variants": [
      "success",
      "warning",
      "error",
      "neutral"
    ],
    "states": [
      null
    ],
    "chip": {
      "label": "Even",
      "height": "22px",
      "padding": "0 var(--space-3)",
      "fontSize": "var(--text-11)",
      "fontWeight": "var(--weight-semibold)",
      "radius": "var(--radius-full)"
    }
  },
  "13 \u00b7 TriggerPill": {
    "cssPath": "src/renderer/src/atoms/TriggerPill/TriggerPill.module.css",
    "base": "trigger",
    "variants": [
      null,
      "block"
    ],
    "baseLabel": "pill",
    "states": [
      null,
      "hover",
      "focus-visible"
    ],
    "chip": {
      "label": "Filters",
      "height": "var(--control-height-lg)",
      "padding": "0 var(--space-4)",
      "fontSize": "var(--text-13)",
      "fontWeight": "var(--weight-semibold)",
      "radius": "var(--radius-full)"
    }
  },
  "3 \u00b7 Input": {
    "cssPath": "src/renderer/src/atoms/Input/Input.module.css",
    "base": "input",
    "variants": [
      null,
      "error"
    ],
    "baseLabel": "default",
    "states": [
      null,
      "focus-visible",
      "disabled"
    ],
    "chip": {
      "label": "Coral",
      "height": "var(--control-height-lg)",
      "padding": "0 var(--space-4)",
      "fontSize": "var(--text-14)",
      "fontWeight": "var(--weight-regular)",
      "radius": "var(--radius-md)"
    }
  },
  "7 \u00b7 SegmentedControl": {
    "cssPath": "src/renderer/src/atoms/SegmentedControl/SegmentedControl.module.css",
    "base": "seg",
    "variants": [
      null,
      "segOn"
    ],
    "baseLabel": "off",
    "states": [
      null,
      "hover"
    ],
    "chip": {
      "label": "From hex",
      "height": "var(--control-height-md)",
      "padding": "0 var(--space-4)",
      "fontSize": "var(--text-13)",
      "fontWeight": "var(--weight-medium)",
      "radius": "var(--radius-full)"
    }
  },
  "14 \u00b7 MenuOption": {
    "cssPath": "src/renderer/src/atoms/MenuOption/MenuOption.module.css",
    "base": "option",
    "variants": [
      null
    ],
    "baseLabel": "row",
    "states": [
      null,
      "hover"
    ],
    "chip": {
      "label": "Perfect fourth",
      "height": "32px",
      "padding": "0 var(--space-3)",
      "fontSize": "var(--text-13)",
      "fontWeight": "var(--weight-regular)",
      "radius": "var(--radius-sm)"
    }
  }
}